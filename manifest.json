{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "直聘|猎聘 沟通助手-dev",
  "version": "6.2.1",
  "description": "自动筛选岗位，批量发送消息，同步并保存岗位、公司和聊天记录，导入导出历史数据",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "unlimitedStorage",
    "sidePanel",
    "windows",
    "tabs"
  ],
  "host_permissions": [
    "https://*.liepin.com/*",
    "https://*.zhipin.com/*",
    "https://api-c.liepin.com/*",
    "https://api-im.liepin.com/*",
    "https://www.google-analytics.com/*"
  ],
  "action": {
    "default_title": "直聘|猎聘 沟通助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.liepin.com/*"
      ],
      "js": [
        "src/liepin-online-job-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.zhipin.com/*"
      ],
      "js": [
        "src/boss-message-protocol.js",
        "src/boss-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.liepin.com/*",
        "https://*.zhipin.com/*"
      ],
      "js": [
        "src/shared-utils.js",
        "src/shared-records.js",
        "src/content-common.js",
        "src/online-job-filter.js",
        "src/site-adapters.js",
        "src/job-sync-core.js",
        "src/boss-extractor.js",
        "src/liepin-extractor.js",
        "src/content.js",
        "src/boss-auto-greeting.js",
        "src/liepin-auto-greeting.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/boss-hook.js",
        "src/boss-message-protocol.js"
      ],
      "matches": [
        "https://*.zhipin.com/*"
      ]
    }
  ]
}
